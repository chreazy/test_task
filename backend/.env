# Переменные для локального бэкенда и для TypeORM CLI (миграции).
# В docker-compose.yml у сервиса `api` значение DATABASE_HOST перекрывается на `postgres` (имя сервиса в сети Compose).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=journal
PORT=3000
NODE_ENV=development
